<launch>
    <!-- External Gazebo/PX4 provides odometry and LiDAR; no internal simulator is started. -->
    <arg name="map_size_x" default="200.0"/>
    <arg name="map_size_y" default="200.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="odom_topic" default="/mavros/local_position/odom"/>
    <arg name="cloud_topic" default="/velodyne_points_world"/>
    <arg name="goal_topic" default="/move_base_simple/goal"/>
    <arg name="flight_type" default="1"/>
    <arg name="point_num" default="1"/>
    <arg name="target0_x" default="0.0"/>
    <arg name="target0_y" default="0.0"/>
    <arg name="target0_z" default="0.0"/>
    <arg name="target1_x" default="0.0"/>
    <arg name="target1_y" default="0.0"/>
    <arg name="target1_z" default="0.0"/>
    <arg name="target2_x" default="0.0"/>
    <arg name="target2_y" default="0.0"/>
    <arg name="target2_z" default="0.0"/>
    <arg name="target3_x" default="0.0"/>
    <arg name="target3_y" default="0.0"/>
    <arg name="target3_z" default="0.0"/>
    <arg name="target4_x" default="0.0"/>
    <arg name="target4_y" default="0.0"/>
    <arg name="target4_z" default="0.0"/>

    <include file="$(find diff_planner)/launch/gazebo_sim/advanced_param_sim.xml">
        <arg name="drone_id" value="0"/>
        <arg name="planner_node_name" value="diff_planner_node"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="odom_remap_topic" value="$(arg odom_topic)"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="cloud_remap_topic" value="$(arg cloud_topic)"/>
        <!-- LiDAR mode: these unused camera inputs must still have valid ROS names. -->
        <arg name="camera_pose_topic" value="unused_camera_pose"/>
        <arg name="depth_topic" value="unused_depth"/>
        <arg name="camera_pose_remap_topic" value="unused_camera_pose"/>
        <arg name="depth_remap_topic" value="unused_depth"/>
        <arg name="trajectory_topic" value="/planning/trajectory"/>
        <arg name="data_display_topic" value="/planning/data_display"/>
        <arg name="heartbeat_topic" value="/traj_server/heartbeat"/>
        <arg name="goal_topic" value="$(arg goal_topic)"/>
        <arg name="cx" value="321.04638671875"/>
        <arg name="cy" value="243.44969177246094"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>
        <arg name="max_vel" value="1.5"/>
        <arg name="max_acc" value="6.0"/>
        <arg name="max_jer" value="20.0"/>
        <arg name="planning_horizon" value="7.5"/>
        <arg name="use_multitopology_trajs" value="false"/>
        <arg name="flight_type" value="$(arg flight_type)"/>
        <arg name="point_num" value="$(arg point_num)"/>
        <arg name="point0_x" value="$(arg target0_x)"/><arg name="point0_y" value="$(arg target0_y)"/><arg name="point0_z" value="$(arg target0_z)"/>
        <arg name="point1_x" value="$(arg target1_x)"/><arg name="point1_y" value="$(arg target1_y)"/><arg name="point1_z" value="$(arg target1_z)"/>
        <arg name="point2_x" value="$(arg target2_x)"/><arg name="point2_y" value="$(arg target2_y)"/><arg name="point2_z" value="$(arg target2_z)"/>
        <arg name="point3_x" value="$(arg target3_x)"/><arg name="point3_y" value="$(arg target3_y)"/><arg name="point3_z" value="$(arg target3_z)"/>
        <arg name="point4_x" value="$(arg target4_x)"/><arg name="point4_y" value="$(arg target4_y)"/><arg name="point4_z" value="$(arg target4_z)"/>
    </include>

    <node pkg="diff_planner" name="traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="/setpoints_cmd"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>
</launch>
