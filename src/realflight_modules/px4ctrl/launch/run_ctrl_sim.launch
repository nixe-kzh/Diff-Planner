<launch>
    <!-- Keep these defaults aligned with diff_planner/launch/gazebo_sim. -->
    <arg name="odom_topic" default="/mavros/local_position/odom"/>
    <arg name="cmd_topic" default="/setpoints_cmd"/>

	<node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl" output="screen">
	        	<remap from="~odom" to="$(arg odom_topic)" />
		<remap from="~cmd" to="$(arg cmd_topic)" />

        <rosparam command="load" file="$(find px4ctrl)/config/ctrl_param_sim.yaml" />
	</node>
 
</launch>
